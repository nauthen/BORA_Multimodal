{
  "seed": 42,
  "device": "cuda",
  "num_classes": 4,
  "evaluation_mode": "holdout",
  "epochs": 200,
  "batch_size": 256,
  "learning_rate": 0.0001,
  "optimizer": "adam",
  "monitor": "accuracy",
  "early_stopping": true,
  "patience": 50,
  "delta": 0.0,
  "output_dir": "outputs",
  "audio": {
    "backbone": "PANNS_Cnn6",
    "pretrained": false,
    "freeze": false,
    "checkpoint_path": "/marimo/checkpoints/audio_run/DL_audio/checkpoint/panns_cnn6/audio_best.pt"
  },
  "video": {
    "backbone": "SwinTiny",
    "pretrained": true,
    "freeze": false,
    "checkpoint_path": "/marimo/checkpoints/video_run/DL_video/checkpoint/swin_tiny/video_best.pt"
  },
  "fusion": {
    "type": "bora_fusion",
    "proj_dim": 1024,
    "hidden_dim": 256,
    "dropout": 0.2,
    "num_heads": 4,
    "activation": "relu",
    "use_batchnorm": true,
    "bora": {
      "gate_temperature": 0.7,
      "aux_loss_weight": 0.3,
      "reliability_loss_weight": 0.1,
      "warmup_epochs": 5,
      "encoder_lr_scale": 0.1,
      "corruption_probability": 0.3,
      "modality_dropout_probability": 0.05,
      "audio_snr_db": [
        0.0,
        20.0
      ],
      "audio_gain": [
        0.3,
        1.0
      ],
      "temporal_mask_ratio": [
        0.1,
        0.3
      ],
      "video_brightness": [
        0.5,
        1.5
      ],
      "video_blur_sigma": [
        0.1,
        2.0
      ],
      "video_occlusion_ratio": [
        0.1,
        0.3
      ]
    }
  },
  "dataset": {
    "dataset_path": "/marimo/Fish_Feeding_Intensity_Dataset",
    "cache_audio": true,
    "cache_video": true,
    "video_cache_mode": "ram",
    "num_workers": -1,
    "prefetch_factor": null,
    "seed": 42,
    "split_strategy": "random_sample",
    "test_sample_per_class": 700,
    "num_folds": 5,
    "cv_val_ratio": 0.2
  },
  "audio_features": {
    "sample_rate": 64000,
    "window_size": 2048,
    "hop_size": 1024,
    "mel_bins": 128,
    "fmin": 1,
    "fmax": 32000,
    "time_drop_width": 64,
    "time_stripes_num": 2,
    "freq_drop_width": 8,
    "freq_stripes_num": 2,
    "freeze_parameters": true
  },
  "video_features": {
    "image_size": 224
  }
}
