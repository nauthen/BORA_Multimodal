{
  "seed": 42,
  "device": "cuda",
  "num_classes": 4,
  "evaluation_mode": "holdout",
  "ablation": "none",
  "epochs": 200,
  "batch_size": 32,
  "learning_rate": 0.0001,
  "optimizer": "adam",
  "monitor": "accuracy",
  "early_stopping": true,
  "patience": 200,
  "delta": 0.0,
  "output_dir": "outputs",
  "audio": {
    "backbone": "TinyPANNS_ECA",
    "pretrained": false,
    "freeze": false,
    "checkpoint_path": "/marimo/checkpoints/audio_run/DL_audio/checkpoint/panns_cnn6/audio_best.pt",
    "cv_checkpoint_path": ""
  },
  "video": {
    "backbone": "MobileViTXXS",
    "pretrained": false,
    "freeze": false,
    "checkpoint_path": "/marimo/checkpoints/video_run/U_FFIA27K_video/checkpoint/mobilevit_xxs/video_best.pt",
    "cv_checkpoint_path": ""
  },
  "fusion": {
    "type": "temporal_bora_fusion",
    "proj_dim": 256,
    "hidden_dim": 256,
    "dropout": 0.15,
    "num_heads": 4,
    "activation": "gelu",
    "use_batchnorm": false,
    "bora": {
      "gate_temperature": 0.3,
      "aux_loss_weight": 0.3,
      "reliability_loss_weight": 0.1,
      "warmup_epochs": 3,
      "encoder_lr_scale": 0.1,
      "corruption_probability": 0.1,
      "modality_dropout_probability": 0.02,
      "audio_snr_db": [5.0, 20.0],
      "audio_gain": [0.5, 1.0],
      "temporal_mask_ratio": [0.1, 0.2],
      "video_brightness": [0.7, 1.3],
      "video_blur_sigma": [0.1, 1.0],
      "video_occlusion_ratio": [0.05, 0.2],
      "categorical_loss_weight": 1.0,
      "motion_loss_weight": 0.1,
      "nominal_loss_weight": 0.5,
      "teacher_preservation_weight": 0.3,
      "temporal_num_layers": 2,
      "temporal_num_heads": 4,
      "temporal_max_frames": 16
    }
  },
  "dataset": {
    "dataset_path": "/marimo/Fish_Feeding_Intensity_Dataset",
    "cache_audio": true,
    "cache_video": true,
    "video_cache_mode": "ram",
    "num_workers": -1,
    "prefetch_factor": null,
    "seed": 42,
    "split_strategy": "random_sample",
    "test_sample_per_class": 700,
    "num_folds": 5,
    "cv_val_ratio": 0.2
  },
  "audio_features": {
    "sample_rate": 64000,
    "window_size": 2048,
    "hop_size": 1024,
    "mel_bins": 128,
    "fmin": 1,
    "fmax": 32000,
    "time_drop_width": 64,
    "time_stripes_num": 2,
    "freq_drop_width": 8,
    "freq_stripes_num": 2,
    "freeze_parameters": true
  },
  "video_features": {
    "image_size": 224,
    "num_frames": 2
  }
}
